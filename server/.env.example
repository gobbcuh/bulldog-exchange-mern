NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bulldog_exchange?replicaSet=rs0
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_random_secret
PAYMONGO_SECRET_KEY=replace_with_your_test_secret_key
PAYMONGO_WEBHOOK_SECRET=replace_with_your_test_webhook_secret
PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,qrph

# Only needed when provisioning an administrator:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace_with_a_12_to_128_character_password
